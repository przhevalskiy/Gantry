[Unit]
Description=Gantry Temporal Worker
After=network.target docker.service gantry-api.service
Requires=docker.service

[Service]
Type=simple
User=gantry
WorkingDirectory=/opt/gantry
EnvironmentFile=/opt/gantry/.env
ExecStart=/opt/gantry/.venv/bin/agentex agents run --manifest manifest.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gantry-worker

[Install]
WantedBy=multi-user.target
