[Unit]
Description=Monolift Gantry API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=monolift
WorkingDirectory=/opt/monolift
EnvironmentFile=/opt/monolift/.env
ExecStart=/opt/monolift/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8001 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gantry-api

[Install]
WantedBy=multi-user.target
