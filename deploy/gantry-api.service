[Unit]
Description=Gantry API Server
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=gantry
WorkingDirectory=/opt/gantry
EnvironmentFile=/opt/gantry/.env
ExecStart=/opt/gantry/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8001 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gantry-api

[Install]
WantedBy=multi-user.target
