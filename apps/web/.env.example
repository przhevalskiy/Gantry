# Gantry platform UI (apps/web factory shell)
# Default: Gantry mode — UI talks to Gantry :8001 via /v1 proxy (dev) or VITE_GANTRY_API_URL (prod).

# Set false only when running against legacy Qodex :8000 backend
VITE_GANTRY_PLATFORM=true

# Production API origin (leave empty in dev — Vite proxies /v1 and /health to :8001)
# VITE_GANTRY_API_URL=https://api.your-gantry.example

# Local dev — skip API key modal (./dev.sh sets this; pair with GANTRY_DEV_AUTH_BYPASS on API)
# VITE_GANTRY_DEV_AUTH_BYPASS=true

# Legacy Qodex backend (only when VITE_GANTRY_PLATFORM=false)
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
