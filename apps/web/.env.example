# Gantry web — factory shell (apps/web)
# See deploy/invariants.ts for Vercel vs local rules.

# ── Vercel / production (required) ───────────────────────────────────────────
# Public Gantry API origin — no trailing slash
# VITE_GANTRY_API_URL=https://api.gantry.dev

# ── Local dev only ───────────────────────────────────────────────────────────
# Leave VITE_GANTRY_API_URL unset — Vite proxies /v1 and /health to :8001
# VITE_GANTRY_DEV_AUTH_BYPASS=true   # pair with GANTRY_DEV_AUTH_BYPASS on API; NEVER on Vercel prod
