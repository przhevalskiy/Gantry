# Gantry — production environment
# Copy to /opt/gantry/.env on the Hetzner server and fill in values

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ────────────────────────────────────────────────────────────────────
GH_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=<generate: openssl rand -hex 32>

# ── URLs (update to your actual domains) ──────────────────────────────────────
AGENTEX_BASE_URL=http://localhost:5003
AGENTEX_API_URL=http://localhost:5003
GANTRY_UI_URL=https://app.gantry.dev

# ── Temporal (self-hosted via Docker on same server) ────��─────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Worker ────────────────────────────────────────────────────────────────────
WORKFLOW_TASK_QUEUE=gantry_queue
GANTRY_HOME=/opt/gantry/.gantry

# ── Optional ──────────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
MAX_AGENT_TURNS=24

# ── Agentex agent registration ────────────────────────────────────────────────
GANTRY_AGENT_NAME=swarm-factory
ENVIRONMENT=production
