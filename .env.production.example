# Gantry — production environment (VPS: /opt/gantry/.env)
# See docs/hosting/PLAN.md and DEPLOYMENT.md

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GH_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=<openssl rand -hex 32>
INTERNAL_API_KEY=<openssl rand -hex 32>

# ── URLs (match your DNS) ─────────────────────────────────────────────────────
GANTRY_WEB_URL=https://app.gantry.dev
GANTRY_CORS_ORIGINS=https://app.gantry.dev,https://your-project.vercel.app
# Worker → Gantry API (push lifecycle / structured results). Required in prod.
GANTRY_API_URL=http://127.0.0.1:8001

# Agentex cluster (dependency — not Gantry-owned stores)
# Bundle mode (deploy/agentex compose on this host):
AGENTEX_BASE_URL=http://localhost:5003
TEMPORAL_ADDRESS=localhost:7233
# External mode (AGENTEX_MODE=external in setup.sh): point these at the shared cluster.
TEMPORAL_NAMESPACE=default

# ── Worker / platform ─────────────────────────────────────────────────────────
WORKFLOW_TASK_QUEUE=gantry_queue
GANTRY_AGENT_NAME=swarm-factory
GANTRY_HOME=/opt/gantry/.gantry
ENVIRONMENT=production
# Status sync: worker push is primary. Poller is a slow safety net.
# GANTRY_STATUS_POLLER=fallback   # default (60s). Use off | legacy
# GANTRY_STATUS_POLL_INTERVAL=60

# ── Auth / data (recommended for production) ────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/gantry
# GANTRY_BOOTSTRAP_TOKEN=<openssl rand -hex 32>
# GANTRY_SECRETS_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# ── Never in production ───────────────────────────────────────────────────────
# GANTRY_DEV_AUTH_BYPASS=true

# ── Optional ──────────────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-4-6
# MAX_AGENT_TURNS=24
# BRAVE_SEARCH_API_KEY=
