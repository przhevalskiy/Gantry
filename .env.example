# LLM — worker fallback (optional when customers BYOK via /v1/settings)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# LLM — Mistral (optional alternative)
# Set MISTRAL_API_KEY and override model names below to use Mistral instead of Claude.
# Example: CLAUDE_SONNET_MODEL=mistral-large-latest routes all Sonnet agents to Mistral Large.
# MISTRAL_API_KEY=...
# CLAUDE_SONNET_MODEL=mistral-large-latest
# CLAUDE_HAIKU_MODEL=mistral-small-latest

# Web Search
TAVILY_API_KEY=tvly-...

# Agentex
AGENT_NAME=web-scout
ACP_URL=http://localhost:8000
ACP_PORT=8000
AGENTEX_BASE_URL=http://localhost:5003

# Temporal
TEMPORAL_ADDRESS=localhost:7233
WORKFLOW_NAME=web-scout
WORKFLOW_TASK_QUEUE=web_scout_queue

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# Feature flags
USE_MOCK_BROWSER=false
USE_MOCK_SEARCH=false

# Hard caps
MAX_AGENT_TURNS=20
MAX_PAGES_PER_TASK=8

# Gantry API (platform control plane)
GANTRY_API_PORT=8001
GANTRY_AGENT_NAME=swarm-factory
# DATABASE_URL=postgresql://user:pass@localhost:5432/gantry
# GANTRY_BOOTSTRAP_TOKEN=           # required to create first API key in production
# GANTRY_SECRETS_KEY=               # Fernet key for org secrets at rest
# GANTRY_PUBLIC_URL=http://localhost:8001
# GITHUB_WEBHOOK_SECRET=            # GitHub Issues → Gantry integration

# GitHub App — preferred auth for platform integrations (replaces PAT-per-task)
# Create at https://github.com/settings/apps/new
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=gantry
# GITHUB_APP_PRIVATE_KEY=          # PEM contents (use \n for newlines in .env)
# GITHUB_APP_WEBHOOK_SECRET=       # defaults to GITHUB_WEBHOOK_SECRET
# GANTRY_INSTALL_STATE_SECRET=     # HMAC for install state (defaults to bootstrap token)

# Per-org LLM BYOK — platform customers configure via API, not worker .env:
#   POST /v1/secrets  {"name":"anthropic-prod","value":"sk-ant-..."}
#   PATCH /v1/settings {"provider":"anthropic","api_key_secret":"anthropic-prod"}
